# Development fallback only.
#
# The packaged app reads its credentials from the macOS Keychain (Settings →
# Credentials), not from this file. A .env next to bot.js is still read when
# running in development or using the plain CLI, and Settings offers a one-click
# "Import from .env" to move these into the Keychain.
#
# Copy to .env and fill in. .env is gitignored — never commit it.

INDFAK_USERNAME=you@sund.ku.dk
INDFAK_PASSWORD=
TOTP_SECRET=
ANTHROPIC_API_KEY=

# Optional — the app sets these itself from Settings; only needed for CLI runs.
# RECEIPTS_INBOX=/Users/you/claude_vm/receipts-inbox
# CLAIMS_OUTPUT=/Users/you/claude_vm/claims-output
